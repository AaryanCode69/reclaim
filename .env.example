# Copy to .env (backend/scripts) or app/.env (Expo) and fill in. Never commit real values.

# AWS
AWS_PROFILE=reclaim
AWS_REGION=ap-south-1

# Bedrock (see CLAUDE.md §12)
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Expo app (EXPO_PUBLIC_* values are bundled into the app)
EXPO_PUBLIC_AWS_REGION=ap-south-1
EXPO_PUBLIC_LOCATION_API_KEY=v1.public.REPLACE_ME
EXPO_PUBLIC_API_URL=https://REPLACE_ME.execute-api.ap-south-1.amazonaws.com
EXPO_PUBLIC_USER_POOL_ID=ap-south-1_REPLACE_ME
EXPO_PUBLIC_USER_POOL_CLIENT_ID=REPLACE_ME
